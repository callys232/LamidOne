# ─────────────────────────────────────────────────────────────
# LAMID ONE — environment
# Copy to .env.local. Never commit the filled version.
# GET /api/health reports which of these are wired, without
# echoing any value.
# ─────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────
# Canonical origin — used by robots.txt and sitemap.xml. Set to the
# real deployed URL in production; defaults to localhost otherwise.
NEXT_PUBLIC_SITE_URL=

# ── Model layer ──────────────────────────────────────────────
# One of these is required for the assistant and language agents.
# OpenRouter takes precedence when both are set.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LAMID_MODEL=openai/gpt-4o-mini

# ── Rate limiting ────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without it, limits fall back to an
# in-memory counter, which on serverless is per-instance — an
# attacker simply gets N times the limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Data ─────────────────────────────────────────────────────
# Same cluster as ProdLamid, so points and tiers have one authority.
MONGODB_URI=

# ── Auth ─────────────────────────────────────────────────────
# Must match ProdLamid's secret so sessions are portable.
JWT_SECRET=

# ── Webhooks ─────────────────────────────────────────────────
# Guards POST /api/points. Without it that endpoint stays closed,
# which is the safe default — an open credit endpoint is free money.
LAMID_WEBHOOK_SECRET=

# ── Transactional email (Resend) ──────────────────────────────
# Password reset, organisation invitations, and every notify() call
# (awarded, milestone funded/approved/disputed, and so on — respecting
# each user's own emailed-notifications preference). Unset, those
# actions still succeed; the email side is silently skipped rather
# than failing the request.
RESEND_API_KEY=
MAIL_FROM=

# ── Error monitoring (Sentry) ─────────────────────────────────
# SENTRY_DSN is server + edge; NEXT_PUBLIC_SENTRY_DSN is the browser
# copy (ships to the client, so it's a separate variable on purpose).
# Unset, Sentry.init is never called — no SDK overhead, nothing to
# disable in development. The SENTRY_ORG/PROJECT/AUTH_TOKEN trio is
# only for uploading source maps at build time; without them the build
# still succeeds, it just skips that upload.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# ── Bot protection (Cloudflare Turnstile) ─────────────────────
# NEXT_PUBLIC_TURNSTILE_SITE_KEY ships to the browser and renders the
# widget on signup and forgot-password; TURNSTILE_SECRET_KEY verifies
# the resulting token server-side. Unset (either or both), the widget
# doesn't render and the server never asks for a token — this is
# opt-in hardening, not something that can lock out real users by
# being unconfigured.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Card payments (Stripe) ─────────────────────────────────────
# A second checkout rail alongside Paystack — same checkout routes
# (api/checkout/tier, api/checkout/points), selected with
# {"provider":"stripe"} in the request body. STRIPE_WEBHOOK_SECRET
# guards api/webhooks/stripe the same way PAYSTACK_SECRET_KEY guards
# its Paystack equivalent. Unset, both checkout routes return 503 for
# a Stripe request and behave exactly as before for a Paystack one.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# LAMID LEARN (LMS) — talent pathways pull completed learning from here.
# Unset, the pathway falls back to manually entered learning and says so.
# NOTE: the LMS does not yet expose the required read endpoints
# (GET /api/courses, GET /api/learners/{email}/completions) — see the
# contract documented at the top of src/lib/learning.ts.
LAMID_LMS_BASE_URL=
LAMID_LMS_API_KEY=

# ── Accounting sync (Xero / QuickBooks) ──────────────────────────────
# ⚠️ UNVERIFIED: the OAuth flow follows each provider's documented
# authorization-code grant but has never successfully authenticated,
# because registering a developer app needs an account and a reviewed
# redirect URI. Needs one real end-to-end test before being relied on.
# Unset, the connect route returns 503 and nothing calls out.
# Redirect URI to register:
#   {NEXT_PUBLIC_SITE_URL}/api/integrations/accounting/callback?provider=xero
#   {NEXT_PUBLIC_SITE_URL}/api/integrations/accounting/callback?provider=quickbooks
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# ── Contracts Finder corpus ──────────────────────────────────────────
# No key needed (open data). The corpus is refreshed by
# POST /api/cron/refresh-awards using LAMID_CRON_SECRET below; until it
# has run at least once, public-award comparables report an empty corpus.

# ── Demo sign-in ─────────────────────────────────────────────────────
# /demo-dev signs a visitor straight in as a fixed demo account —
# INCLUDING an operator account with broader access than any customer
# tier. Off in production unless set, so it is not a public operator
# login. Set to "true" while walking the dashboards on a real
# deployment; UNSET IT BEFORE LAUNCH.
LAMID_ALLOW_DEMO_LOGIN=

# ── Scheduled jobs ───────────────────────────────────────────────────
# Vercel Cron sends GET with "Authorization: Bearer $CRON_SECRET".
# LAMID_CRON_SECRET is the equivalent for manual curl / external
# schedulers via the x-lamid-cron-secret header. Either works; set at
# least one or the cron routes reject everything and the jobs in
# vercel.json silently never run.
CRON_SECRET=
