# ─────────────────────────────────────────────────────────────
# LAMID ONE — environment
# Copy to .env.local. Never commit the filled version.
# GET /api/health reports which of these are wired, without
# echoing any value.
# ─────────────────────────────────────────────────────────────

# ── Site ──────────────────────────────────────────────────────
# Canonical origin — used by robots.txt and sitemap.xml. Set to the
# real deployed URL in production; defaults to localhost otherwise.
NEXT_PUBLIC_SITE_URL=

# ── Model layer ──────────────────────────────────────────────
# One of these is required for the assistant and language agents.
# OpenRouter takes precedence when both are set.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LAMID_MODEL=openai/gpt-4o-mini

# ── Rate limiting ────────────────────────────────────────────
# REQUIRED IN PRODUCTION. Without it, limits fall back to an
# in-memory counter, which on serverless is per-instance — an
# attacker simply gets N times the limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Data ─────────────────────────────────────────────────────
# Same cluster as ProdLamid, so points and tiers have one authority.
MONGODB_URI=

# ── Auth ─────────────────────────────────────────────────────
# Must match ProdLamid's secret so sessions are portable.
JWT_SECRET=

# ── Webhooks ─────────────────────────────────────────────────
# Guards POST /api/points. Without it that endpoint stays closed,
# which is the safe default — an open credit endpoint is free money.
LAMID_WEBHOOK_SECRET=

# LAMID LEARN (LMS) — talent pathways pull completed learning from here.
# Unset, the pathway falls back to manually entered learning and says so.
# NOTE: the LMS does not yet expose the required read endpoints
# (GET /api/courses, GET /api/learners/{email}/completions) — see the
# contract documented at the top of src/lib/learning.ts.
LAMID_LMS_BASE_URL=
LAMID_LMS_API_KEY=

# ── Accounting sync (Xero / QuickBooks) ──────────────────────────────
# ⚠️ UNVERIFIED: the OAuth flow follows each provider's documented
# authorization-code grant but has never successfully authenticated,
# because registering a developer app needs an account and a reviewed
# redirect URI. Needs one real end-to-end test before being relied on.
# Unset, the connect route returns 503 and nothing calls out.
# Redirect URI to register:
#   {NEXT_PUBLIC_SITE_URL}/api/integrations/accounting/callback?provider=xero
#   {NEXT_PUBLIC_SITE_URL}/api/integrations/accounting/callback?provider=quickbooks
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# ── Contracts Finder corpus ──────────────────────────────────────────
# No key needed (open data). The corpus is refreshed by
# POST /api/cron/refresh-awards using LAMID_CRON_SECRET below; until it
# has run at least once, public-award comparables report an empty corpus.
